 concurrency:
-  # A pull request's newer push replaces the run it supersedes. Every push to main keeps its own run: in one shared group a
-  # newer push cancels the run that is waiting, so merges landing every few minutes during a 35-minute run were never tested.
-  group: ci-${{ github.event.pull_request.number || github.sha }}-${{ github.event_name }}
+  # A pull request's newer push replaces the run it supersedes. Pushes to main share one group, so while a run is going
